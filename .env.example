# =============================================================================
# EventPro — variables d'environnement
# Copier ce fichier en `.env` puis remplacer toutes les valeurs `change-me-*`.
# Éviter les caractères spéciaux (@ : / #) dans les mots de passe : ils sont
# injectés dans des URI de connexion.
# =============================================================================

# --- PostgreSQL applicatif (pgvector) ----------------------------------------
POSTGRES_USER=eventpro
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=eventpro
POSTGRES_PORT=5432

# --- Airflow -----------------------------------------------------------------
# Sous Linux : AIRFLOW_UID=$(id -u). Sous Windows/macOS : laisser 50000.
AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=change-me-airflow-db
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-airflow-jwt
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-admin
AIRFLOW_PORT=8080

# --- Backend FastAPI ---------------------------------------------------------
ENVIRONMENT=local
API_PORT=8000
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-api-jwt
CORS_ORIGINS=["http://localhost:3000"]

# --- Embeddings (doit être identique partout : batch, streaming, API) --------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Streaming (profil docker compose "streaming") ---------------------------
WEBHOOK_PORT=8001
WEBHOOK_SECRET=change-me-webhook
KAFKA_TOPIC_EVENTS=events.incoming
KAFKA_TOPIC_DLQ=events.dlq
